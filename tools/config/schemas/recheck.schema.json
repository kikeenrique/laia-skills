{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kikeenrique/laia-skills/tools/config/schemas/recheck.schema.json",
  "title": "laiaskills re-check agent",
  "description": "The AI agent CLI `laiaskills upgrade` runs to re-check a first-party skill after its upstream pin moves.",
  "type": "object",
  "required": ["agent", "commands", "timeoutMinutes"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "agent": { "type": "string", "description": "Key in `commands` to use." },
    "commands": {
      "type": "object",
      "description": "Agent id → command line. The element `{prompt}` is replaced with the rendered prompt from prompts/recheck.md.",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string" },
        "contains": { "const": "{prompt}" }
      }
    },
    "timeoutMinutes": { "type": "integer", "minimum": 1 }
  }
}
