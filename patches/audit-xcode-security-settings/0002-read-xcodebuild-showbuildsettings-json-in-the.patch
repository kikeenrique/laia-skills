 #!/usr/bin/env python3
 """Filter GetTargetBuildSettings JSON to security-relevant entries.
 
+Also reads `xcodebuild -showBuildSettings -json` output (a list of
+{"target": ..., "buildSettings": {NAME: value}} objects). That format has
+evaluated values only, so --show-overrides has no effect on it, and each
+line is prefixed with the target name when it covers more than one target.
+
 Usage:
     filter_build_settings.py <saved-file> [--show-overrides] [--unhardened-only] [--regex REGEX]
 """
